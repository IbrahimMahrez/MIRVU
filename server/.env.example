# Server Configuration
PORT=3001
NODE_ENV=development

# CORS - Frontend URL
CLIENT_URL=http://localhost:5173

# LLM Provider Configuration
# Choose "gemini", "openai", or "groq". Keep provider keys available to switch.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional alternative; keep the Gemini key above)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Groq API Key (optional alternative; free-tier rate limits apply)
# Create one at https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=qwen/qwen3.8-27b

# Optional neural TTS for clear Egyptian Arabic and English technical terms
# Create an Azure Speech resource and set its key and region to enable it.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Interview Configuration
DEFAULT_MAIN_QUESTIONS=5
MAX_FOLLOW_UP_QUESTIONS=2
DATASET_QUESTION_RATIO=0.6

# Session Configuration
SESSION_TIMEOUT_MS=1800000

# Optional full path to python.exe; defaults to "python"
PYTHON_EXECUTABLE=python
